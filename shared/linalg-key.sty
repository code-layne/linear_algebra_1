\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{linalg-key}[2026/06/01 Linear Algebra answer-key additions]

\RequirePackage{linalg-boxes}

% ── The work rule ─────────────────────────────────────────────────────────────
% \begin{work} is defined in linalg-boxes and is authored identically in the
% blank and the key. The blank reserves the block's exact height and ships
% nothing; loading this package is what makes the same block visible. See the
% comment above the environment in linalg-boxes.sty.
\la@workvisibletrue

% ── Answer macros ─────────────────────────────────────────────────────────────
\newcommand{\ans}[1]{\textcolor{keyred}{\textbf{#1}}}
\newcommand{\ansline}[1]{%
    \vspace{1pt}\noindent\textcolor{keyred}{\textbf{#1}}%
    \textcolor{linegray}{\dotfill}\vspace{3pt}}

% Filled-in vocabulary entry: the answer-key counterpart of \termblanklong.
% \vocabans{Term}{definition} → burgundy bold "Term:" followed by the keyed answer.
%
% VOCABPAR: this opens with \noindent, a NO-OP in the middle of a paragraph, so a
% vocabbox that starts with an intro sentence runs that sentence into the first
% term. The fix is per-lesson, not here (patching it would re-flow every already-
% verified lesson at once): put \par\vspace{2pt} after the intro sentence, in the
% blank AND the key. See references/conventions.md ("vocabpar").
\newcommand{\vocabans}[2]{%
    \noindent\textbf{\textcolor{burgundy}{#1:}}\ \ans{#2}\par\vspace{3pt}}

% ── Teacher note box ──────────────────────────────────────────────────────────
% MOVED to linalg-boxes: teacher notes now live in the lesson plan, which loads
% -boxes and not -key. It takes an optional component title there
% (\begin{teachernote}[Warm-Up]) and a bare \begin{teachernote} still works, so
% keys not yet migrated keep compiling. See "Teacher notes" in linalg-boxes.sty.
